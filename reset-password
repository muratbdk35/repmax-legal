<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RepMax – Şifre Sıfırla</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f0d4cb, #e2d6ee, #cfddf0);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      padding: 24px;
    }
    .card {
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 48px 40px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 8px 40px rgba(0,0,0,0.10);
      border: 1px solid rgba(255,255,255,0.9);
    }
    .logo {
      width: 140px;
      margin-bottom: 24px;
    }
    .badge {
      display: inline-block;
      background: rgba(232,56,12,0.10);
      color: #E8380C;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid rgba(232,56,12,0.20);
      margin-bottom: 28px;
    }
    h1 {
      font-size: 22px;
      font-weight: 800;
      color: #161310;
      margin-bottom: 8px;
    }
    p {
      font-size: 14px;
      color: #7A726B;
      margin-bottom: 28px;
    }
    .input-wrap {
      position: relative;
      margin-bottom: 14px;
      text-align: left;
    }
    label {
      display: block;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: #7A726B;
      margin-bottom: 8px;
    }
    input {
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1.5px solid rgba(0,0,0,0.12);
      background: rgba(255,255,255,0.9);
      font-size: 15px;
      color: #161310;
      outline: none;
      transition: border-color 0.2s;
    }
    input:focus { border-color: #E8380C; }
    button {
      width: 100%;
      padding: 16px;
      background: #E8380C;
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 0 20px rgba(232,56,12,0.35);
      transition: opacity 0.2s;
    }
    button:hover { opacity: 0.9; }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    .msg {
      margin-top: 16px;
      font-size: 14px;
      font-weight: 600;
      min-height: 20px;
    }
    .msg.ok { color: #2E8C5E; }
    .msg.err { color: #E8380C; }
  </style>
</head>
<body>
  <div class="card">
    <img class="logo" src="https://muratbdk35.github.io/repmax-legal/repmax.png" alt="RepMax" onerror="this.style.display='none'">
    <div class="badge">HYPERTROPHY TRACKER</div>
    <h1>Yeni Şifre Belirle</h1>
    <p>Aşağıya yeni şifreni gir.</p>
    <div class="input-wrap">
      <label>YENİ ŞİFRE</label>
      <input type="password" id="password" placeholder="••••••••" minlength="6"/>
    </div>
    <div class="input-wrap">
      <label>ŞİFRE TEKRAR</label>
      <input type="password" id="password2" placeholder="••••••••" minlength="6"/>
    </div>
    <button id="btn" onclick="handleReset()">Şifreyi Güncelle</button>
    <div class="msg" id="msg"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const { createClient } = supabase;
    const sb = createClient(
      'https://kwvbkilslrbjtzfllxvc.supabase.co',
      'sb_publishable_AS7xt1EBxhNRuWS1vaVaqw_RBwYdcK_'
    );

    // URL'deki hash token'ı Supabase'e bildir
    sb.auth.getSession();

    async function handleReset() {
      const pw = document.getElementById('password').value;
      const pw2 = document.getElementById('password2').value;
      const msg = document.getElementById('msg');
      const btn = document.getElementById('btn');

      if (pw.length < 6) { msg.className='msg err'; msg.textContent='Şifre en az 6 karakter olmalı.'; return; }
      if (pw !== pw2) { msg.className='msg err'; msg.textContent='Şifreler eşleşmiyor.'; return; }

      btn.disabled = true;
      btn.textContent = 'Güncelleniyor...';

      const { error } = await sb.auth.updateUser({ password: pw });

      if (error) {
        msg.className='msg err';
        msg.textContent = 'Hata: ' + error.message;
        btn.disabled = false;
        btn.textContent = 'Şifreyi Güncelle';
      } else {
        msg.className='msg ok';
        msg.textContent = '✓ Şifren güncellendi! Uygulamayı açabilirsin.';
        btn.textContent = '✓ Tamamlandı';
      }
    }
  </script>
</body>
</html>
